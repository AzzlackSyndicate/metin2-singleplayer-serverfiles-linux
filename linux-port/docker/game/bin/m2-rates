#!/bin/sh
# =============================================================================
#  m2-rates -- server-wide experience / item drop / yang rates, container side.
#
#  On FreeBSD the panel and the game are one machine, so the panel simply runs
#  apply_rates.sh: it rewrites the game's data tables and restarts the cores.
#  Here they are two containers.  A script started inside the panel container
#  cannot touch this container's files and cannot restart these cores, so the
#  shell-out became a request/response across a shared spool directory:
#
#      panel container                     game container (this file)
#      ---------------                     --------------------------
#      apply_rates.sh
#        writes  $SPOOL/request     ---->  m2-rates poll     (every 5s, from
#        writes  $SPOOL/rates.status         m2-supervise's watch loop)
#                                              |
#                                              v
#                                           m2-rates apply   (rewrites the
#                                              |               tables)
#                                              v
#                                           m2-supervise stops and starts the
#                                           cores in the tested order
#                                              |
#        reads   $SPOOL/rates.status  <----- m2-rates publish
#
#  Nothing else crosses the boundary: no Docker socket, no SSH, no extra port.
#  The spool is a named volume mounted into both containers, group-shared
#  between the two service accounts (see the Dockerfiles).
#
#  The numbers themselves are worked out by exactly the same code the FreeBSD
#  installer uses -- pack_apply_rates() out of the server-files profile, which
#  is copied into this image as /opt/metin2/rates/pack.sh.  There is no second
#  implementation of the rate maths to drift out of step, and its two rules
#  hold here too: every value is scaled from an untouched *.m2orig baseline, so
#  200% then 300% gives 300% and not 600%, and 100% gives the shipped file back
#  byte for byte.
#
#  Why the tables are rewritten again on every container start: they live in
#  the image, and a container's writable layer is thrown away whenever the
#  container is recreated (`docker compose up -d' after an .env change, an
#  image rebuild, ...).  That puts the shipped tables back, so what the
#  operator asked for is kept on the state volume ($STATE_DIR/wanted) and
#  re-applied before the cores read anything.  The baseline copies live in the
#  same writable layer as the tables they belong to, so the two can never fall
#  out of step: either both are there, or the tables are pristine and the
#  baselines are recreated from them.
#
#  Subcommands
#      prepare        as root, at container start: spool + file ownership
#      apply          rewrite the tables from $STATE_DIR/wanted
#      poll           new request from the panel?  exit 10 = yes, apply it
#      publish [S M]  write the status file the panel reads; with no argument
#                     it republishes the result of the last apply
# =============================================================================
set -u
LC_ALL=C
export LC_ALL

SHARE_DIR="${M2_SHARE_DIR:-/opt/metin2/share}"
VAR_DIR="${M2_VAR_DIR:-/opt/metin2/var}"

# The game tree as the profile expects to address it: it looks for
# $GAME_DIR/share/conf and $GAME_DIR/share/locale, which is exactly the layout
# in this image one level above SHARE_DIR.
GAME_DIR="${M2_GAME_DIR:-$(dirname "$SHARE_DIR")}"

SPOOL="${M2_RATES_SPOOL:-/opt/m2spool}"
PACK="${M2_RATES_PACK:-/opt/metin2/rates/pack.sh}"

STATE_DIR="$VAR_DIR/rates"
WANTED="$STATE_DIR/wanted"          # what the operator asked for, kept forever
LAST_ID="$STATE_DIR/last-id"        # the request we have already dealt with
RESULT="$STATE_DIR/last-result"     # how the last apply went

REQUEST="$SPOOL/request"
STATUS="$SPOOL/rates.status"

# The panel's own message for a failed change points at /var/log/m2rates.log on
# the server, so that is where this writes -- inside the game container, which
# is the machine that actually applies the rates.  The state volume is the
# fallback for a container where /var/log is not writable.
LOG="${M2_RATES_LOG:-/var/log/m2rates.log}"
if ! { : >>"$LOG"; } 2>/dev/null; then
    LOG="$STATE_DIR/apply.log"
    mkdir -p "$STATE_DIR" 2>/dev/null
    { : >>"$LOG"; } 2>/dev/null || LOG=/dev/null
fi

RATE_EXP=100
RATE_DROP=100
RATE_YANG=100

# Everything goes to the log AND to stdout: stdout of the supervisor is the
# container log, which is where an operator looks first.
say()  { printf '%s [rates] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "$1"; }
note() { say "$1"; say "$1" >>"$LOG" 2>/dev/null; }

# The three names the profile's hook expects from its caller.
ok()   { note "  [ ok ] $1"; }
warn() { note "  [ !! ] $1"; }
fail() { note "  [ XX ] $1"; }
step() { note "== $1"; }
run()  { "$@" >>"$LOG" 2>&1; }
ask()  { ANSWER="$2"; }   # nothing here can ask a question -- take the default

# ---------------------------------------------------------------------------
#  Small helpers
# ---------------------------------------------------------------------------

# sane_rate VALUE -> a percentage that can safely be calculated with. Anything
# missing, non-numeric or absurd becomes 100, i.e. "leave it alone".
sane_rate() {
    _v="${1:-}"
    case "${_v:-x}" in ''|*[!0-9]*) _v=100 ;; esac
    [ "$_v" -lt 1 ] && _v=100
    [ "$_v" -gt 10000 ] && _v=10000
    printf '%s' "$_v"
}

# kv FILE KEY -> the value of a "key=value" line, empty when there is none
kv() {
    [ -f "$1" ] || return 0
    sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1
}

read_wanted() {
    RATE_EXP=$(sane_rate  "$(kv "$WANTED" exp)")
    RATE_DROP=$(sane_rate "$(kv "$WANTED" drop)")
    RATE_YANG=$(sane_rate "$(kv "$WANTED" yang)")
}

# write_status STATE MESSAGE -- the one file the panel reads back.
#
# Written to a temporary file and renamed, for two reasons: the panel may read
# it at any moment and must never see half a line, and a rename only needs
# write permission on the spool directory. The panel writes this same file
# from its own container as its own user (it sets "running" the moment somebody
# presses save), so replacing it wholesale is the only reliable way to update
# it from here.
write_status() {
    _tmp="$STATUS.new.$$"
    { printf 'state=%s\n' "$1"
      printf 'time=%s\n' "$(date +%s 2>/dev/null)"
      printf 'exp=%s\ndrop=%s\nyang=%s\n' "$RATE_EXP" "$RATE_DROP" "$RATE_YANG"
      printf 'message=%s\n' "$2"
    } > "$_tmp" 2>/dev/null || { rm -f "$_tmp"; return 1; }
    # Group-writable on purpose: the panel account has to be able to overwrite
    # it in place the next time somebody saves the page.
    chmod 0660 "$_tmp" 2>/dev/null
    mv "$_tmp" "$STATUS" 2>/dev/null || { rm -f "$_tmp"; return 1; }
    return 0
}

remember_result() { # remember_result STATE MESSAGE
    mkdir -p "$STATE_DIR" 2>/dev/null
    { printf 'state=%s\n' "$1"; printf 'message=%s\n' "$2"; } > "$RESULT.new" 2>/dev/null \
        && mv "$RESULT.new" "$RESULT" 2>/dev/null
    return 0
}

# ---------------------------------------------------------------------------
#  prepare -- run as root from the entrypoint, before privileges are dropped
# ---------------------------------------------------------------------------
# Two things need root and cannot be done later:
#
#   * the spool directory has to exist and be usable by both service accounts.
#     It is a fresh named volume, so on first start it is an empty root-owned
#     directory. setgid + the shared m2spool group means files created in it
#     belong to that group whoever writes them.
#   * the data tables are baked into the image as root. The rates are applied
#     by the supervisor, which runs unprivileged, so the handful of files and
#     the two directories it has to write are handed over. Nothing else in the
#     image changes owner -- the cores only ever read these.
# ---------------------------------------------------------------------------
cmd_prepare() {
    mkdir -p "$STATE_DIR" 2>/dev/null
    chown metin2:metin2 "$STATE_DIR" 2>/dev/null

    if [ -d "$SPOOL" ]; then
        chgrp m2spool "$SPOOL" 2>/dev/null && chmod 2770 "$SPOOL" 2>/dev/null
    else
        say "no spool directory at $SPOOL -- rate changes from the panel will not arrive."
        say "  Mount the rates-spool volume there (see docker-compose.yml)."
    fi

    if [ "$LOG" != /dev/null ] && [ -f "$LOG" ]; then
        chown metin2:metin2 "$LOG" 2>/dev/null
        chmod 0640 "$LOG" 2>/dev/null
    fi

    # mob_proto.txt carries EXP / GOLD_MIN / GOLD_MAX; the drop tables live in
    # the one locale directory. The directories go too: the profile writes its
    # baseline copy and its temporary file next to each table.
    _loc=$(find "$SHARE_DIR/locale" -maxdepth 2 -type d -name quest 2>/dev/null | head -1)
    [ -n "$_loc" ] && _loc=$(dirname "$_loc")
    for _p in "$SHARE_DIR/conf" \
              "$SHARE_DIR/conf/mob_proto.txt" \
              "$SHARE_DIR/conf/mob_proto.txt.m2orig" \
              ${_loc:+"$_loc"} \
              ${_loc:+"$_loc/mob_drop_item.txt"} \
              ${_loc:+"$_loc/mob_drop_item.txt.m2orig"} \
              ${_loc:+"$_loc/common_drop_item.txt"} \
              ${_loc:+"$_loc/common_drop_item.txt.m2orig"} \
              ${_loc:+"$_loc/etc_drop_item.txt"} \
              ${_loc:+"$_loc/etc_drop_item.txt.m2orig"}; do
        [ -e "$_p" ] && chown metin2:metin2 "$_p" 2>/dev/null
    done
    return 0
}

# ---------------------------------------------------------------------------
#  apply -- rewrite the tables from what the operator asked for
# ---------------------------------------------------------------------------
# Called twice over a rate change's life: once by the supervisor when a request
# arrives, and once on every container start, because the writable layer that
# held the rewritten tables may have been thrown away in between.
#
# It is deliberately quiet and successful when nothing was ever asked for --
# that is the state of a freshly installed server, not a problem.
# ---------------------------------------------------------------------------
cmd_apply() {
    [ -f "$WANTED" ] || return 0
    read_wanted

    if [ ! -f "$PACK" ]; then
        fail "The server-files profile ($PACK) is not in this image"
        remember_result unsupported "the server-files profile is missing"
        write_status unsupported "the server-files profile is missing"
        return 2
    fi
    # The profile is a library of shell functions; sourcing it defines them and
    # a set of PACK_* / P_* variables and does nothing else.
    # shellcheck disable=SC1090
    . "$PACK"

    if ! command -v pack_apply_rates >/dev/null 2>&1; then
        warn "These server files do not support changing the rates -- nothing was changed"
        remember_result unsupported "these server files do not support rate changes"
        write_status unsupported "these server files do not support rate changes"
        return 2
    fi

    step "Applying experience ${RATE_EXP}%, item drops ${RATE_DROP}%, yang ${RATE_YANG}%"
    write_status running "the rates are being applied"

    export RATE_EXP RATE_DROP RATE_YANG GAME_DIR
    if pack_apply_rates; then
        # Not "ok" yet: the cores read these tables once, while they start, so
        # the rates are not live until they have been restarted. The supervisor
        # publishes the result once they are back up.
        remember_result ok "the new rates are live"
        return 0
    fi

    fail "The rates could not be applied -- the tables were left exactly as they were"
    remember_result failed "the rates could not be applied"
    write_status failed "the rates could not be applied"
    return 1
}

# ---------------------------------------------------------------------------
#  poll -- has the panel asked for something new?
# ---------------------------------------------------------------------------
# Exit codes:  0  nothing to do
#             10  a new request was accepted and staged; the caller has to run
#                 `apply' and restart the cores
#
# The request file is never deleted and never written from here: the panel
# owns it and overwrites it every time somebody saves the page. What has been
# dealt with already is remembered by id on this side, so a request can be
# read twice without being applied twice, and a spool that briefly disappears
# cannot resurrect an old change.
# ---------------------------------------------------------------------------
cmd_poll() {
    [ -f "$REQUEST" ] || return 0

    _id=$(kv "$REQUEST" id)
    [ -n "$_id" ] || return 0
    _seen=""
    [ -f "$LAST_ID" ] && _seen=$(cat "$LAST_ID" 2>/dev/null)
    [ "$_id" = "$_seen" ] && return 0

    _e=$(kv "$REQUEST" exp); _d=$(kv "$REQUEST" drop); _y=$(kv "$REQUEST" yang)

    # Remember the id first, whatever happens next. A request we cannot use is
    # a request we must not read again on the next five-second tick.
    mkdir -p "$STATE_DIR" 2>/dev/null
    printf '%s\n' "$_id" > "$LAST_ID" 2>/dev/null

    for _v in "$_e" "$_d" "$_y"; do
        case "${_v:-x}" in ''|*[!0-9]*)
            RATE_EXP=$(sane_rate "$_e"); RATE_DROP=$(sane_rate "$_d"); RATE_YANG=$(sane_rate "$_y")
            fail "The panel sent a rate that is not a number -- nothing was changed"
            remember_result failed "the panel sent a value that is not a number"
            write_status failed "the panel sent a value that is not a number"
            return 0 ;;
        esac
        if [ "$_v" -lt 1 ] || [ "$_v" -gt 10000 ]; then
            fail "The panel sent a rate outside 1-10000 -- nothing was changed"
            remember_result failed "the panel sent a value outside 1-10000"
            write_status failed "the panel sent a value outside 1-10000"
            return 0
        fi
    done

    { printf 'exp=%s\ndrop=%s\nyang=%s\n' "$_e" "$_d" "$_y"
      printf 'time=%s\n' "$(date +%s 2>/dev/null)"
    } > "$WANTED.new" 2>/dev/null && mv "$WANTED.new" "$WANTED" 2>/dev/null || {
        rm -f "$WANTED.new"
        fail "Could not write $WANTED -- the state volume is not writable"
        remember_result failed "the game container could not store the new rates"
        write_status failed "the game container could not store the new rates"
        return 0
    }

    RATE_EXP="$_e"; RATE_DROP="$_d"; RATE_YANG="$_y"
    note "the panel asked for experience ${_e}%, item drops ${_d}%, yang ${_y}% (request $_id)"
    return 10
}

# ---------------------------------------------------------------------------
#  publish -- write the status the panel reads
# ---------------------------------------------------------------------------
# With arguments it publishes those; with none it republishes the result of the
# last apply, which is how the supervisor says "and now the cores are back up".
# ---------------------------------------------------------------------------
cmd_publish() {
    # Nothing was ever asked for, so there is nothing to report. This is what
    # keeps a freshly installed server's rates page quiet instead of announcing
    # the outcome of a change nobody made.
    [ -f "$WANTED" ] || return 0
    read_wanted
    if [ $# -ge 1 ]; then
        write_status "$1" "${2:-}"
        return 0
    fi
    [ -f "$RESULT" ] || return 0
    write_status "$(kv "$RESULT" state)" "$(kv "$RESULT" message)"
    return 0
}

case "${1:-}" in
    prepare) cmd_prepare ;;
    apply)   cmd_apply ;;
    poll)    cmd_poll ;;
    publish) shift; cmd_publish "$@" ;;
    *) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
       echo "usage: m2-rates prepare|apply|poll|publish [state [message]]"
       exit 1 ;;
esac
