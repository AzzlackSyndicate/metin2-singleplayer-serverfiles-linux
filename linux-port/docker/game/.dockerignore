# The build context for the game image is this directory. Keep out of it
# anything the build does not read, so the context transfer stays fast.

# Derived artefacts -- the image rebuilds all of these from source, and shipping
# stale ones is exactly how a "from source" build silently isn't.
**/*.o
**/*.a
**/OBJDIR/
**/.obj/
**/tags

# The FreeBSD prebuilt dependency archives. They are ELF "version 1 (FreeBSD)"
# and cannot link on Linux; the Linux set is built by build-deps-40250.sh.
src/extern/lib/

# The shipped FreeBSD binaries (90 MB + 20 MB) and any Linux ones lying around.
# The image's binaries come from the builder stage.
src/serverfiles/share/bin/

# Visual Studio / FreeBSD build leftovers in the source tree.
**/*.vcproj
**/*.vcxproj*
**/*.vssscc
**/*.vspscc
**/*.sln
**/Debug/
**/win32/

# Runtime state, if the staging ever picks any up.
**/log/
**/cores/
**/syslog
**/syserr
**/stdout
**/PTS
**/pid
