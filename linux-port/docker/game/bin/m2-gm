#!/bin/bash
# =============================================================================
#  m2-gm -- tell the running server that the list of game masters changed.
#
#  Granting somebody the in-game admin commands is one row in common.gmlist,
#  and the panel writes that row itself.  The catch is that the game reads the
#  table exactly once, when the db core boots, and never looks again: without
#  the nudge in this file a new game master stays a normal player until the
#  next restart, which is the sort of "it did nothing" that gets reported as a
#  broken button.
#
#  The nudge is a text command on a game core's admin socket.  That interface
#  is the reason this lives in the game container rather than in the panel: it
#  also accepts SHUTDOWN, DC and NOTICE, and the panel is the one process here
#  that faces the internet.  So the same request/response across the shared
#  spool that m2-rates uses:
#
#      panel container                   game container (this file)
#      ---------------                   --------------------------
#      writes $SPOOL/gm.request  ----->  m2-gm poll   (every 5s, from
#                                          |           m2-supervise's loop)
#                                          v
#                                        "@RELOAD a" on a core's admin socket
#                                          |
#                                          v
#                                        db core re-reads common.gmlist and
#                                        broadcasts it to every channel
#
#  There is no field in the request that says what to do.  There is one verb,
#  it is written below, and the file only ever carries an id so the same change
#  is not applied twice.
#
#  Two things about the protocol, both from game/src/input.cpp:
#
#    * A text command is the byte '@' (HEADER_CG_TEXT is 64), the command, and
#      a newline.  The server answers with a line of its own -- but "UNKNOWN"
#      is what it says both for a command it does not have AND for a command it
#      ran that sets no result, RELOAD among them.  So the reply to the reload
#      cannot be used to tell success from failure, and this script does not
#      pretend otherwise: it proves the interface is talking to us with
#      IS_SERVER_UP, which has a real answer, and reports on that.
#
#    * ENABLE_PORT_SECURITY is compiled in, so the interface answers only
#      connections coming from an address in the core's ADMINPAGE_IP.  That is
#      127.0.0.1 by default, i.e. exactly this container and nothing else --
#      which is why the connection below is to the loopback address and why
#      widening M2_ADMINPAGE_IP is a thing to think twice about.
#
#  Subcommands
#      poll     a new request from the panel?  If so, do the reload.
#      reload   do the reload now, whatever the spool says.
# =============================================================================
set -u
LC_ALL=C
export LC_ALL

VAR_DIR="${M2_VAR_DIR:-/opt/metin2/var}"
SPOOL="${M2_RATES_SPOOL:-/opt/m2spool}"
PLAN="$VAR_DIR/boot-plan"

STATE_DIR="$VAR_DIR/gm"
LAST_ID="$STATE_DIR/last-id"
REQUEST="$SPOOL/gm.request"

# The password the cores were configured with. Both sides read the same
# variable, so this matches by construction; entrypoint.sh renders it into
# every CONFIG from the same value.
ADMIN_PW="${M2_ADMINPAGE_PASSWORD:-}"

say() { printf '%s [gm] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "$1"; }

# The value of key KEY in a "key=value" file.
kv() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }

# The ports of the game cores, in boot order. The db core has no admin socket
# worth talking to and the auth core is not where the reload starts, so only
# the ones marked `game' are of interest.
game_ports() {
    [ -f "$PLAN" ] || return 0
    while IFS='|' read -r _name _dir _bin port kind; do
        [ "$kind" = "game" ] && printf '%s\n' "$port"
    done < "$PLAN"
}

# Say the three lines to one core and print whatever comes back. Returns
# non-zero when the core cannot be reached at all.
talk_to() {
    _port="$1"
    exec 3<>"/dev/tcp/127.0.0.1/$_port" 2>/dev/null || return 1
    # IS_SERVER_UP first: it is the one command here with an answer that means
    # something, so it doubles as proof that the interface is open to us.
    printf '@IS_SERVER_UP\n'   >&3
    printf '@%s\n' "$ADMIN_PW" >&3
    printf '@RELOAD a\n'       >&3
    # The first thing on the wire is the core's binary handshake packet, so the
    # reply is filtered down to printable characters rather than read as lines.
    timeout 3 dd bs=1 count=200 <&3 2>/dev/null | tr -cd '[:print:]\n'
    exec 3<&- 2>/dev/null
    return 0
}

cmd_reload() {
    if [ ! -f "$PLAN" ]; then
        say "no boot plan at $PLAN -- cannot tell which cores to talk to."
        return 1
    fi

    _tried=0
    for _port in $(game_ports); do
        _tried=$((_tried + 1))
        _reply=$(talk_to "$_port") || { say "core on port $_port is not accepting connections"; continue; }
        case "$_reply" in
            *YES*|*NO*)
                # IS_SERVER_UP answered, so the admin socket is open to this
                # container and the reload went down the same pipe. One core is
                # enough: it forwards to the db core, which re-reads the table
                # and broadcasts the new list to every channel.
                say "asked the core on port $_port to re-read the game master list"
                return 0 ;;
            *)
                say "core on port $_port did not answer its admin socket"
                say "  ADMINPAGE_IP in its CONFIG has to contain 127.0.0.1 for this to work." ;;
        esac
    done

    [ "$_tried" = "0" ] && say "no game cores in $PLAN"
    say "the game master list could not be reloaded -- it will be read at the next restart"
    return 1
}

cmd_poll() {
    [ -f "$REQUEST" ] || return 0

    _id=$(kv "$REQUEST" id)
    [ -n "$_id" ] || return 0
    _seen=""
    [ -f "$LAST_ID" ] && _seen=$(cat "$LAST_ID" 2>/dev/null)
    [ "$_id" = "$_seen" ] && return 0

    # Remember it before acting. A request that cannot be carried out is a
    # request that must not be retried on every five-second tick for the rest
    # of the container's life.
    mkdir -p "$STATE_DIR" 2>/dev/null
    printf '%s\n' "$_id" > "$LAST_ID" 2>/dev/null

    cmd_reload
    return 0
}

case "${1:-}" in
    poll)   cmd_poll ;;
    reload) cmd_reload ;;
    *)      printf 'usage: m2-gm poll|reload\n' >&2; exit 2 ;;
esac
