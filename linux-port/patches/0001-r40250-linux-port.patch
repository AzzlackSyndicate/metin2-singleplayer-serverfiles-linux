+static_assert(sizeof(TPacketGiveEmpirePriv)     == 10, "TPacketGiveEmpirePriv wire layout changed");
+static_assert(sizeof(TPacketDGChangeGuildPriv)  == 14, "TPacketDGChangeGuildPriv wire layout changed");
+static_assert(sizeof(TPacketDGChangeEmpirePriv) == 11, "TPacketDGChangeEmpirePriv wire layout changed");
