+EM_BOOL OnPointerLockChangeDom(int /*eventType*/,
+                              const EmscriptenPointerlockChangeEvent* e,
+                              void* userData)
+{
+    // M2_POINTERLOCK_CHANGE.
+    auto* self = Self(userData);
+
+    // wasLocked, so a stray isActive=false (a request that was refused outright never
+    // locked anything) cannot invent a release for a drag that was never captured.
+    const bool wasLocked = CanvasInputAccess::PointerLocked(self);
+    const bool active    = (e->isActive != 0);
+    CanvasInputAccess::PointerLocked(self) = active;
+
+    if (active)
+    {
+        CanvasInputAccess::SeedLockOrigin(self);
+        return EM_FALSE;
+    }
+
+    // ── THE LOCK CAN END WITHOUT US, AND THE DRAG MUST NOT OUTLIVE IT ────────────────
+    //
+    // Escape, Alt-Tab, a tab switch and the browser's own timeout all exit Pointer Lock, and
+    // NONE of them delivers a mouseup. Without this the client goes on believing the right
+    // button is held: the camera stays in drag, the cursor stays hidden, and the next click
+    // is interpreted as part of a rotation that ended long ago. That is the "halber Zustand"
+    // this handler exists to make impossible.
+    //
+    // A synthetic RightUp at the PINNED position is exactly the event that never arrived,
+    // and it runs the ordinary release path — CPythonPlayer::NEW_SetMouseCameraState ->
+    // EndDrag, cursor restored — rather than a second, parallel teardown that would have to
+    // be kept in step with it.
+    //
+    // Guarded on m_lockWanted so the ordinary path does not double-deliver:
+    // ReleaseCameraPointerLock clears the flag BEFORE calling exit, so the change event it
+    // provokes falls straight through here.
+    if (wasLocked && CanvasInputAccess::LockWanted(self))   // M2_SYNTHETIC_RIGHTUP_SET
+    {
+        CanvasInputAccess::LockWanted(self)        = false;
+        CanvasInputAccess::RightUpSynthesised(self) = true;
+        CanvasInputAccess::Push(self, CanvasEventKind::RightUp,
+                                CanvasInputAccess::MouseX(self),
+                                CanvasInputAccess::MouseY(self));
+    }
+
+    return EM_FALSE;
+}
