-- =============================================================
-- Serverwide movement-speed boost.
--
-- Every character gets the bonus below the moment they log in.
-- No item, no button, nothing to know about - it is simply how
-- fast people run on this server.
--
-- The percentage is written into `want' below by
-- linux-port/docker/prepare-context.sh, from M2_MOVE_SPEED_BONUS
-- in .env, before qc compiles this file. Changing it is one
-- installer run; the quest swaps the old affect for the new one
-- at each character's next login, so nothing has to be cleaned
-- up when the number goes up, down, or back to zero.
--
-- ── WHY THERE IS A TIMER AND NOT JUST A LOGIN HANDLER ────────
--
-- The core wipes every affect on death:
--
--     SetPosition(POS_DEAD);
--     ClearAffect(true);          -- char_battle.cpp
--
-- so a login-only version leaves a player running at normal
-- speed from their first death until they next log in. That is
-- exactly how it was reported: "the buff goes away after a
-- while", by players who had died, while somebody who had not
-- died still had it.
--
-- There is no `dead' event in this source -- the quest system
-- knows login, logout, kill, levelup, click, chat and timers,
-- and nothing that fires on dying. So the timer re-applies it,
-- and a death costs at most one minute of normal speed.
--
-- ── HOW IT AVOIDS THE CLASSIC PITFALLS ───────────────────────
--
--   * affect.add() in this source DOES stack duplicates (its
--     internal guard compares an APPLY_* constant against a
--     stored POINT_* constant, which never matches), so the
--     quest only ever adds when affect.get_apply_on(1000) says
--     no quest affect exists yet.  1000 = AFFECT_QUEST_START_IDX.
--     get_apply_on returns nil when the affect is absent
--     (questlua_affect.cpp), which is what makes that check
--     trustworthy and the timer cheap: no packet churn while the
--     affect is where it should be.
--   * The affect persists in the database, so it survives
--     logouts; the duration only counts down while the player is
--     online - a year of playtime is not reachable, and a
--     smaller number leaves more room before any arithmetic on
--     it can overflow.
--   * The panel's own speed command (web_admin.quest) uses
--     affect.add_collect, a different affect type, so the two
--     never touch each other.
--
-- This file assumes it is the only quest using plain affect.add
-- on this server. If you add another one, key it differently.
-- =============================================================
quest speed_boost begin
	state start begin
		when login begin
			local want = 20
			local mov = 8 -- APPLY_MOV_SPEED; apply.MOV_SPEED where the locale defines it
			if apply ~= nil and apply.MOV_SPEED ~= nil then
				mov = apply.MOV_SPEED
			end
			if pc.getqf("applied") ~= want then
				affect.remove(1000)
				pc.setqf("applied", 0)
			end
			if affect.get_apply_on(1000) == nil then
				affect.add(mov, want, 60*60*24*365)
				pc.setqf("applied", want)
			end
			-- Re-applied every minute, because death clears it.
			loop_timer("speed_boost_recheck", 60)
		end

		when speed_boost_recheck.timer begin
			local want = 20
			local mov = 8
			if apply ~= nil and apply.MOV_SPEED ~= nil then
				mov = apply.MOV_SPEED
			end
			if pc.getqf("applied") ~= want then
				affect.remove(1000)
				pc.setqf("applied", 0)
			end
			if affect.get_apply_on(1000) == nil then
				affect.add(mov, want, 60*60*24*365)
				pc.setqf("applied", want)
			end
		end
	end
end
