# =============================================================
#  The authoritative ignore rules are in the REPOSITORY ROOT's
#  .gitignore, one level up. This file only adds the few things
#  that are specific to this directory.
#
#  Everything here is meant to be tracked: admin_panel.py,
#  items.json, favicon.png, web_admin.quest, speed_boost.quest,
#  web_admin_schema.sql, packs/ and the .md files.
#  linux-port/docker/prepare-context.sh reads five of them by
#  path, so nothing in here may be renamed, moved or dropped
#  from the checkout without changing that script too.
# =============================================================

# Do not re-introduce a pre-built bundle of these files. It goes out of date
# the moment anything is edited, and someone will eventually install from the
# stale copy. Publish the plain files and let git do the bundling.
m2-suite.tar.gz
m2-suite.zip

# Generated at install time on a real server; contains real secrets
m2panel.conf
*.conf.local
client.zip
*.log

# Extracted server files, if anyone ever unpacks them in here
game/
share/

__pycache__/
*.pyc
